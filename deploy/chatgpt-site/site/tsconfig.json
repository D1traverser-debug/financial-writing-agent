{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "db/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
