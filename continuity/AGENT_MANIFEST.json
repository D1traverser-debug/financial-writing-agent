{
  "schema_version": "1.1",
  "architecture_contract_version": "1.4",
  "owner": "FINANCIAL_WRITING_AGENT_RUNTIME",
  "owner_kind": "BUSINESS",
  "product_interface": {
    "interaction_surface": "CHATGPT",
    "entry_model": "SINGLE_OWNER_ENTRY",
    "execution_mode_selection": "NONE",
    "business_contract_model": "SINGLE_CANONICAL_OWNER_WORKFLOW",
    "durable_business_state_authority": "GITHUB_MAIN_ARTICLE_WORKSPACE"
  },
  "skill": {
    "role": "ROUTER",
    "entrypoint": "skills/financial-writing-agent/SKILL.md",
    "current_note": "Skill is the Financial domain entry. UAOS is the cross-domain controller; this repository remains the domain code/rules/artifact and fine-grained article-state provider."
  },
  "runtime": {
    "runtime_type": "SINGLE_GITHUB_BACKED_OWNER",
    "execution_contract": "continuity/FINANCIAL_OWNER_EXECUTION.json",
    "canonical_guard_implementation": "financial_writing_agent/owner_guard.py",
    "canonical_lifecycle_implementation": "financial_writing_agent/owner_lifecycle.py",
    "capability_profile": "continuity/EXECUTION_CAPABILITIES.json",
    "judgment_execution": "EXECUTABLE_WHEN_EXACT_STAGE_CAPABILITIES_ARE_AVAILABLE",
    "alternate_business_state_runtime_allowed": false,
    "note": "Financial business semantics remain local; UAOS owns cross-domain intent, task identity, continuation and capability orchestration."
  },
  "workflow": {
    "state_authority_refs": ["continuity/FINANCIAL_OWNER_EXECUTION.json", "financial_writing_agent/models.py", "financial_writing_agent/routing.py", "financial_writing_agent/owner_guard.py"],
    "transition_guard_refs": ["financial_writing_agent/workflow_spec.py", "financial_writing_agent/owner_guard.py", "financial_writing_agent/owner_lifecycle.py"],
    "shared_business_contract": {
      "task_contract_ref": "financial_writing_agent/models.py::TaskContract",
      "routing_ref": "financial_writing_agent/routing.py::build_task_contract",
      "default_distribution_mode": "DUAL",
      "default_delivery_channel": "WORD_FILE_ONLY",
      "default_required_outputs": ["AUDIT_DOCX", "FINANCE_DEEP_DOCX", "FINANCE_BROAD_DOCX"],
      "business_state_ref": "main",
      "business_state_root": "workspaces/articles/{task_id}"
    }
  },
  "legacy_quarantine": {
    "negative_space_contract": "config/retired_runtime_paths.json",
    "retired_runtime_current_tree_status": "PHYSICALLY_ABSENT_REQUIRED",
    "historical_evals_and_maintenance_branches": "EVIDENCE_ONLY",
    "no_fallback_activation": true
  },
  "harness": {
    "ci_workflow_ref": ".github/workflows/ci.yml",
    "commands": ["pytest -q", "python scripts/eval_contracts.py", "python scripts/static_audit.py"],
    "negative_space_command": "python scripts/retired_runtime_static_audit.py",
    "suites": ["architecture", "contract", "trajectory", "quality", "artifact", "legacy_quarantine", "blocked_recovery", "system_impact_lifecycle", "retired_runtime_negative_space"]
  },
  "references": {
    "canonical_roots": ["references"],
    "mirror_policy": "GENERATED_PACKAGE_MIRROR",
    "package_mirror": "financial_writing_agent/resources/references"
  },
  "continuity": {
    "controller_ref": "D1traverser-debug/universal-agent-os@main:CURRENT_SYSTEM.json",
    "uaos_adapter_ref": "continuity/UAOS_ADAPTER.json",
    "task_index_ref": "continuity/TASK_INDEX.md",
    "execution_capability_ref": "continuity/EXECUTION_CAPABILITIES.json",
    "execution_contract_ref": "continuity/FINANCIAL_OWNER_EXECUTION.json",
    "legacy_protocol_adapter_ref": "continuity/UNIVERSAL_PROTOCOL_ADAPTER.json",
    "legacy_protocol_status": "READ_ONLY_COMPATIBILITY_EVIDENCE"
  }
}
