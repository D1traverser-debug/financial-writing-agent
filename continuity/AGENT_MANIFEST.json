{
  "schema_version": "1.1",
  "architecture_contract_version": "1.3",
  "owner": "FINANCIAL_WRITING_AGENT_RUNTIME",
  "owner_kind": "BUSINESS",
  "product_interface": {
    "interaction_surface": "CHATGPT",
    "entry_model": "SINGLE_OWNER_ENTRY",
    "execution_mode_selection": "NONE",
    "business_contract_model": "SINGLE_CANONICAL_OWNER_WORKFLOW",
    "durable_business_state_authority": "GITHUB_MAIN_ARTICLE_WORKSPACE"
  },
  "skill": {
    "role": "ROUTER",
    "entrypoint": "skills/financial-writing-agent/SKILL.md",
    "current_note": "Skill is the single ChatGPT-facing Financial entry. There is one GitHub-backed owner trajectory; model/web/Python/document/plugin/MCP facilities are capability providers only and may not create alternate business-state authorities or route selection."
  },
  "runtime": {
    "runtime_type": "SINGLE_GITHUB_BACKED_OWNER",
    "execution_contract": "continuity/FINANCIAL_OWNER_EXECUTION.json",
    "canonical_guard_implementation": "financial_writing_agent/github_chat_guard.py",
    "guard_filename_status": "LEGACY_NAME_RETAINED_FOR_CODE_COMPATIBILITY_ONLY__NOT_ROUTE_SELECTOR",
    "capability_profile": "continuity/EXECUTION_CAPABILITIES.json",
    "judgment_execution": "EXECUTABLE_WHEN_EXACT_STAGE_CAPABILITIES_ARE_AVAILABLE",
    "alternate_business_state_runtime_allowed": false,
    "note": "New and resumed Financial business work uses main/workspaces/articles/{task_id} only. Legacy owner-native/SQLite/plugin task state is not a fallback. Missing capability blocks the affected stage rather than selecting another execution mode."
  },
  "workflow": {
    "state_authority_refs": [
      "continuity/FINANCIAL_OWNER_EXECUTION.json",
      "financial_writing_agent/models.py",
      "financial_writing_agent/routing.py",
      "financial_writing_agent/github_chat_guard.py"
    ],
    "transition_guard_refs": [
      "financial_writing_agent/workflow_spec.py",
      "financial_writing_agent/github_chat_guard.py"
    ],
    "shared_business_contract": {
      "task_contract_ref": "financial_writing_agent/models.py::TaskContract",
      "routing_ref": "financial_writing_agent/routing.py::build_task_contract",
      "default_distribution_mode": "DUAL",
      "default_delivery_channel": "WORD_FILE_ONLY",
      "default_required_outputs": ["AUDIT_DOCX", "FINANCE_DEEP_DOCX", "FINANCE_BROAD_DOCX"],
      "business_state_ref": "main",
      "business_state_root": "workspaces/articles/{task_id}"
    }
  },
  "legacy_quarantine": {
    "inactive_for_new_or_resumed_business_work": [
      "financial_writing_agent/store.py as alternate task authority",
      "financial_writing_agent/runtime_service.py as alternate task authority",
      "financial_writing_agent/plugin_server.py as alternate task authority",
      "per-article Git branches",
      "chat memory"
    ],
    "historical_evals_and_maintenance_branches": "EVIDENCE_ONLY",
    "no_fallback_activation": true
  },
  "harness": {
    "ci_workflow_ref": ".github/workflows/ci.yml",
    "commands": ["python scripts/sdk_smoke.py", "python scripts/mcp_smoke.py", "pytest -q", "python scripts/eval_contracts.py", "python scripts/static_audit.py"],
    "suites": ["architecture", "contract", "trajectory", "quality", "artifact", "legacy_quarantine"]
  },
  "references": {
    "canonical_roots": ["references"],
    "mirror_policy": "GENERATED_PACKAGE_MIRROR",
    "package_mirror": "financial_writing_agent/resources/references"
  },
  "continuity": {
    "task_index_ref": "continuity/TASK_INDEX.md",
    "protocol_adapter_ref": "continuity/UNIVERSAL_PROTOCOL_ADAPTER.json",
    "execution_capability_ref": "continuity/EXECUTION_CAPABILITIES.json",
    "execution_contract_ref": "continuity/FINANCIAL_OWNER_EXECUTION.json"
  }
}