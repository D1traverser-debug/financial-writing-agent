{
  "defaults": {
    "distribution_mode": "DUAL",
    "content_mode": "FORMAL_ARTICLE",
    "delivery_channel": "WORD_FILE_ONLY",
    "language": "zh-CN",
    "title_max_rounds": 3,
    "draft_max_rounds": 2,
    "research_max_rounds": 2
  },
  "finance_compliance": {
    "hard_fail_phrases": ["加仓", "减仓", "低吸", "追涨", "抄底", "止盈", "止损", "目标价", "仓位", "买卖点", "介入时点", "核心推荐", "最值得买"],
    "semantic_review_terms": ["买入", "卖出"]
  },
  "style": {
    "continuous_report_prose": true,
    "logical_transitions_required": true,
    "conclusion_first_preferred": true,
    "anti_ai_semantic_audit": true,
    "anti_ai_judge_required": true,
    "heading_hierarchy": ["一、", "（1）", "①"],
    "forbidden_heading_prefixes": ["·", "•"],
    "hard_fail_extreme_phrases": ["最强", "最牛", "最值得", "顶级", "史诗级", "彻底颠覆", "注定暴涨", "必然上涨", "唯一机会"],
    "review_generic_superlatives_semantically": true
  },
  "risk_disclaimer": {
    "required": true,
    "min_body_chars": 60,
    "recommended_max_chars": 320,
    "topic_specific_required": true
  },
  "visuals": {
    "writing_workflow_enabled": false,
    "default_enabled_for_new_word_articles": false,
    "max_file_bytes": 26214400
  },
  "wechat_sticker": {
    "content_mode": "WECHAT_STICKER_POST",
    "require_current_constraint_snapshot": true,
    "hard_coded_title_limit": null,
    "hard_coded_body_limit": null,
    "hard_coded_image_limit": null,
    "interaction_intent_allowed": true,
    "pure_clickbait_forbidden": true,
    "image_generation_owned_by_writing": false
  },
  "word": {
    "title_pt": 20,
    "h1_pt": 18,
    "h2_pt": 13.5,
    "h3_pt": 12,
    "body_pt": 12,
    "h1_rgb": "FF0000",
    "allow_tables": false
  }
}
