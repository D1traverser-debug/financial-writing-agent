{
  "contract_version": "0.8.0",
  "defaults": {
    "distribution_mode": "DUAL",
    "content_mode": "FORMAL_ARTICLE",
    "delivery_channel": "WORD_FILE_ONLY",
    "language": "zh-CN",
    "title_max_rounds": 3,
    "draft_max_rounds": 2,
    "research_max_rounds": 2
  },
  "finance_compliance": {
    "hard_fail_phrases": ["加仓", "减仓", "低吸", "追涨", "抄底", "止盈", "止损", "目标价", "仓位", "买卖点", "介入时点", "核心推荐", "最值得买"],
    "semantic_review_terms": ["买入", "卖出"],
    "no_covert_recommendation_evasion": true,
    "company_comparison_must_remain_non_actionable": true
  },
  "research": {
    "universe_class_coverage_required": true,
    "universe_recall_sources_min": 2,
    "silent_company_omission_forbidden": true,
    "saturation_requires_class_level_recall": true
  },
  "style": {
    "continuous_report_prose": true,
    "conclusion_first_preferred": false,
    "authorial_prose_semantic_audit": true,
    "heading_hierarchy": ["一、", "（1）", "①"],
    "numbering_encouraged": true,
    "deep_numbered_navigation_required_when_branching": true,
    "major_section_bridge_required": true,
    "forbidden_heading_prefixes": ["·", "•"],
    "bold_skim_path_required": true,
    "fidelity_and_responsibility_required": true,
    "semantic_contribution_required": true,
    "argument_progression_required": true,
    "reader_calibration_required": true,
    "authorial_selectivity_required": true,
    "evidence_specificity_required": true,
    "structural_rhythm_naturalness_required": true,
    "template_redundancy_control_required": true,
    "template_cluster_guard_required": true,
    "uncertainty_rhetoric_calibration_required": true,
    "optimize_for_ai_detector": false,
    "writing_dna_learning": {
      "explicit_instruction_is_durable": true,
      "one_off_edit_is_candidate_only": true,
      "repeated_independent_patterns_can_promote": true,
      "external_skill_rules_are_candidates_only": true,
      "raw_learning_sample_ledger_enabled": true,
      "distill_dimensions": ["language", "structure", "topic_framing", "evidence_strategy", "cognitive_moves", "reader_relationship", "anti_patterns"]
    },
    "hard_fail_extreme_phrases": ["注定暴涨", "必然上涨", "唯一机会"],
    "semantic_review_extreme_terms": ["最强", "最牛", "最值得", "顶级", "史诗级", "彻底颠覆"],
    "review_generic_superlatives_semantically": true
  },
  "editorial": {
    "finance_deep_material_complete": true,
    "finance_deep_material_company_mentions_required": true,
    "finance_deep_representative_stock_shortcut_forbidden": true,
    "stock_grounded_validation_sections_required": true,
    "company_comparison_decision_map_required": true,
    "company_comparison_dimensions": ["order_visibility", "realization_speed", "earnings_sensitivity", "overseas_exposure", "technology_optionality"],
    "finance_broad_selective_compression": true,
    "finance_broad_core_contradictions_max": 3,
    "macro_structural_coherence_required": true
  },
  "market_explanation": {
    "activation_policy": "EXPLICIT_SCOPE",
    "required_when_price_formation_material": true,
    "stock_universe_alone_is_not_activation": true,
    "multi_hypothesis_required": true,
    "separate_economic_benefit_from_market_selection": true,
    "why_this_why_not_required": true,
    "continuation_and_reversal_conditions_required": true,
    "causal_confidence_ladder": ["VERIFIED_FACT", "SUPPORTED_MECHANISM", "PLAUSIBLE_INTERPRETATION", "UNRESOLVED"]
  },
  "hooks": {
    "formal_headline_candidates_min": 8,
    "formal_headline_candidates_max": 12,
    "headline_angle_families_min": 5,
    "synonym_only_headline_pool_is_fail": true,
    "qualified_click_required": true,
    "mode_specific_reader_fit_required": true,
    "cross_finance_clickability_required": false,
    "finance_broad_non_niche_stake_required": true,
    "finance_broad_stake_dimensions": ["profit", "orders", "cash_flow", "capital_expenditure", "asset_differentiation", "policy_transmission"],
    "headline_information_value_required": true,
    "headline_curiosity_balance_required": true,
    "question_title_default": "avoid_unless_information_bearing",
    "wechat_search_intent_required": true,
    "first_three_sentences_required": true,
    "continuation_flow_required": true,
    "completion_payoff_required": true,
    "title_opening_payoff_required": true,
    "account_performance_over_generic_demographics": true
  },
  "audit": {
    "semantic_pass_requires_owner_runtime_execution_proof": true,
    "chat_self_review_cannot_pass": true,
    "provider_attested_isolation_required_for_true_independent_claim": true,
    "universe_to_deep_article_reconciliation_required": true,
    "template_cluster_guard_can_force_revise": true
  },
  "risk_disclaimer": {
    "required": true,
    "min_body_chars": 60,
    "recommended_max_chars": 320,
    "topic_specific_required": true,
    "italic": true,
    "inline_paragraph": true,
    "visible_heading": false
  },
  "word": {
    "title_pt": 20,
    "h1_px": 24,
    "h1_pt": 18,
    "h2_px": 20,
    "h2_pt": 15,
    "h3_pt": 12,
    "body_px": 18,
    "body_pt": 13.5,
    "h1_rgb": "FF0000",
    "allow_tables": false,
    "tables_are_hard_fail": true,
    "auto_bold_company_names": false,
    "allow_underline": false,
    "end_source_section_allowed": false
  }
}
